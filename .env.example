# ==============================================================================
# Solana High-Frequency Adaptive Trading Bot - Environment Configuration
# ==============================================================================

# --- 1. WALLET CREDENTIALS ---
# Base58-encoded private key OR JSON byte array: [12,34,56,...]
# CAUTION: Never commit actual private keys to version control.
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Operational Mode: Set to true for paper-trading / dry-run simulation
DRY_RUN=true

# --- 2. MULTI-RPC LOAD BALANCER & WEBSOCKET ENDPOINTS ---
# Primary RPC (e.g. Helius)
PRIMARY_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=your_helius_key
PRIMARY_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=your_helius_key

# Secondary RPC (e.g. QuickNode)
SECONDARY_RPC_HTTP=https://solana-mainnet.quiknode.pro/your_token/
SECONDARY_RPC_WS=wss://solana-mainnet.quiknode.pro/your_token/

# Tertiary / Fallback RPC (e.g. Triton / Extrnode / Public)
FALLBACK_RPC_HTTP=https://api.mainnet-beta.solana.com
FALLBACK_RPC_WS=wss://api.mainnet-beta.solana.com

# Connection & Failover Tuning
RPC_TIMEOUT_SECONDS=4.0
RPC_MAX_RETRIES=3
RPC_HEALTH_CHECK_INTERVAL_SECONDS=15.0

# --- 3. EXECUTION ROUTING & MEV (JUPITER + JITO) ---
# Jupiter v6 Swap API
JUPITER_API_URL=https://quote-api.jup.ag/v6
MAX_SLIPPAGE_BPS=250

# Jito MEV Bundle Configuration
USE_JITO_MEV=true
JITO_BLOCK_ENGINE_URL=https://ny.mainnet.block-engine.jito.wtf
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
JITO_DEFAULT_TIP_PERCENTILE=75
JITO_MIN_TIP_LAMPORTS=100000
JITO_MAX_TIP_LAMPORTS=5000000

# --- 4. MULTI-TIER ANTI-SCAM & LIQUIDITY FILTERS ---
# Holder Distribution Constraints
MAX_TOP10_HOLDER_PERCENT=20.0
MAX_SINGLE_HOLDER_PERCENT=4.0
MIN_HOLDER_SHANNON_ENTROPY=2.2

# Liquidity Health Constraints
MIN_LP_SOL_RESERVES=15.0
MIN_LP_TO_MC_RATIO=0.08
MAX_SIMULATION_ROUNDTRIP_LOSS_PCT=3.0
REQUIRE_LP_BURN=true
REJECT_TOKEN_2022_TAX=true

# --- 5. ADAPTIVE ENTRY & POSITION SIZING ---
# Portfolio Capital Allocation Limits
MIN_POSITION_PCT=0.03
MAX_POSITION_PCT=0.08
KELLY_FRACTION=0.35

# Momentum & Inflow Velocity Detection
MOMENTUM_PERCENTILE_THRESHOLD=90.0
INFLOW_WINDOW_SECONDS=180
MIN_UNIQUE_BUYERS_3M=12
BUY_VELOCITY_WEIGHT=1.25

# --- 6. DYNAMIC EXIT ENGINE & RISK MANAGEMENT ---
# Volatility-Based Trailing Stop
ATR_MULTIPLIER=2.0
VOLATILITY_LOOKBACK_PERIODS=15
CONSECUTIVE_EXHAUSTION_INTERVALS=2

# Stagnation & Decay Cutoff
STAGNATION_TIMEOUT_SECONDS_BASE=120
MIN_VOLUME_MULTIPLIER_BASELINE=2.0

# Master Circuit Breakers & Capital Protection
MAX_DAILY_DRAWDOWN_PCT=0.06
CLUSTER_FAIL_RATE_THRESHOLD=0.25
CLUSTER_TPS_MIN_THRESHOLD=1400
